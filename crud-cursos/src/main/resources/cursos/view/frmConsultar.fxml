<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane prefHeight="380.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <center>
        <TableView fx:id="tabla">
            <columns>
                <TableColumn prefWidth="50.0" text="ID">
                    <cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory>
                </TableColumn>
                <TableColumn prefWidth="90.0" text="Código">
                    <cellValueFactory><PropertyValueFactory property="codCur"/></cellValueFactory>
                </TableColumn>
                <TableColumn prefWidth="260.0" text="Nombre del curso">
                    <cellValueFactory><PropertyValueFactory property="nomCur"/></cellValueFactory>
                </TableColumn>
                <TableColumn prefWidth="70.0" text="Ciclo">
                    <cellValueFactory><PropertyValueFactory property="ciclo"/></cellValueFactory>
                </TableColumn>
                <TableColumn prefWidth="80.0" text="Créditos">
                    <cellValueFactory><PropertyValueFactory property="numCre"/></cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <Button onAction="#onModificar" text="Modificar"/>
            <Button onAction="#onEliminar" text="Eliminar"/>
            <Button onAction="#onActualizar" text="Actualizar"/>
            <Button onAction="#onCerrar" text="Cerrar"/>
        </HBox>
    </bottom>
</BorderPane>
